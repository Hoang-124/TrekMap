# ==============================================================================
# LOST Backend Server Environment Template (Sanitized — ZERO real secrets!)
# Copy to `server/.env` and fill in your environment-specific values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Runtime & Database (REQUIRED in production)
# ------------------------------------------------------------------------------
# Runtime environment: `development` | `production` | `test`
NODE_ENV=development

# HTTP / Socket.IO listen port
PORT=5000

# MongoDB connection string (use MongoDB Atlas / managed cluster in production)
MONGODB_URI=mongodb://127.0.0.1:27017/lost

# Strong HMAC-SHA256 signing secret for Access & Refresh tokens
# REQUIRED in production (minimum 32 chars; 64+ random hex chars recommended):
# Generate via: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-64-char-cryptographically-random-hex-secret

# Canonical frontend base URL (no trailing slash) used for OTP/reset emails,
# itinerary shares, custom routes, and SOS LiveBeacon `/beacon/:token` links.
# Defaults to `https://lost.vn` in production and `http://localhost:5173` in dev.
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. CORS, Reverse Proxy & Cookie Security
# ------------------------------------------------------------------------------
# Comma-separated allowed origins for REST & Socket.IO CORS.
# In production defaults to `https://lost.vn,https://www.lost.vn` when unset.
# (Legacy alias `ALLOWED_ORIGINS` is also supported if `CORS_ORIGINS` is unset.)
CORS_ORIGINS=http://localhost:5173
# ALLOWED_ORIGINS=

# Express `trust proxy` configuration (fails closed to `false` on empty/invalid):
# - Direct / local dev: `false` (or leave empty)
# - Behind 1 reverse proxy (Nginx, Caddy, Render, Cloudflare): `1`
# - Named Express subnet keywords: `loopback` | `linklocal` | `uniquelocal`
TRUST_PROXY=false

# SameSite policy for HttpOnly `lost_refresh` cookie: `lax` (default) | `strict` | `none`
# Note: `none` automatically enforces `Secure` (HTTPS required).
COOKIE_SAME_SITE=lax

# ------------------------------------------------------------------------------
# 3. Database Seeder Controls
# ------------------------------------------------------------------------------
# Password for initial default admin account (`hoang@lost.vn`) on first boot.
# In production, default admin seeding is SKIPPED unless this variable is set.
# Rotate or remove after initial production bootstrap.
ADMIN_SEED_PASSWORD=

# Set to `true` ONLY to force-overwrite seeded catalog records on startup.
# Leave unset/false in normal operation so Admin edits in MongoDB are preserved.
# (Legacy alias `SEED_FORCE_SYNC` is also recognized.)
FORCE_SEED_SYNC=false
# SEED_FORCE_SYNC=false

# ------------------------------------------------------------------------------
# 4. SMTP Transactional Email (Required in production for OTP, Reset & SafetyTimer)
# ------------------------------------------------------------------------------
# Leave blank in local dev to auto-fallback to Ethereal test inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ------------------------------------------------------------------------------
# 5. Optional Integrations (Degrade gracefully when omitted)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client ID (must match client `VITE_GOOGLE_CLIENT_ID`).
# Google Sign-In fails closed if unset.
GOOGLE_CLIENT_ID=

# Cloudinary CDN credentials for user photo/avatar uploads (EXIF stripped).
# Upload endpoints return 503 if unset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini API key for live multimodal AI streaming & photo triage.
# Falls back to deterministic offline `lost-knowledge-engine` if unset.
# (`GOOGLE_API_KEY` is also accepted as an alias.)
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Optional trailhead road-routing providers (falls back to deterministic ETA if unset).
# Never point SELF_HOSTED_OSRM_URL at a public third-party demo server.
ORS_API_KEY=
SELF_HOSTED_OSRM_URL=
