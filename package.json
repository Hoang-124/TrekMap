{
  "name": "lost-vietnam",
  "private": true,
  "license": "UNLICENSED",
  "version": "2.6.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" --names \"SERVER,CLIENT\" --prefix-colors \"magenta,cyan\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "lint": "npm --prefix client run lint -- --max-warnings=0",
    "test": "npm --prefix server test && npm --prefix client test",
    "preview": "npm --prefix client run preview"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
