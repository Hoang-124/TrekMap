# =============================================================================
# LOST Client — Vite Environment Variables Template (Sanitized — Zero Secrets)
# Copy to `client/.env` (or `client/.env.local`) for local development / build.
# All `VITE_*` variables are bundled into public client assets at build time:
# NEVER place private secrets, JWT keys, DB URIs, or API secrets in this file.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Production Same-Origin Reverse Proxy Architecture (/api/* & /socket.io/*)
# -----------------------------------------------------------------------------
# All frontend REST calls (`client/src/services/*.ts`) use relative `/api/*`
# paths and Socket.IO connects on same-origin `/socket.io/*`.
#
# - Local development: `client/vite.config.ts` automatically proxies `/api`
#   and `/socket.io` (with WebSocket upgrade) to `http://127.0.0.1:5000`.
# - Production deployment: serve `client/dist` behind a same-origin HTTPS
#   reverse proxy (Nginx, Caddy, Cloudflare, etc.) with:
#     * `/api/*`       -> backend Express HTTP server (client_max_body_size >= 12m)
#     * `/socket.io/*` -> backend Express Socket.IO with WebSocket Upgrade headers
#     * `/*`           -> SPA fallback to `/index.html`
#     * `Cache-Control: no-cache` on `/index.html` and `/sw.js`
#
# Do NOT configure split-origin REST via `VITE_API_BASE_URL` — same-origin
# reverse proxying keeps HttpOnly refresh cookies (`Path=/api/auth`) and
# REST/Socket sessions strictly aligned without CORS preflight friction.

# -----------------------------------------------------------------------------
# 2. Optional Google Sign-In (Google Identity Services — Public Web Client ID)
# -----------------------------------------------------------------------------
# Must match `GOOGLE_CLIENT_ID` configured on the backend (`server/.env`).
# Leave empty to hide Google Sign-In and use standard email/password OTP auth.
VITE_GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# 3. Optional Custom Satellite Imagery Layer (e.g. Copernicus Sentinel-2 XYZ)
# -----------------------------------------------------------------------------
# Leave empty to use 100% free commercial NASA GIBS Public Domain satellite
# imagery (`BlueMarble` + `VIIRS`) alongside OpenFreeMap + AWS Terrarium DEM.
# Example template: https://your-tile-host.example/sentinel2/{z}/{x}/{y}.jpg
VITE_SATELLITE_TILE_URL=

# Optional attribution HTML/text paired with `VITE_SATELLITE_TILE_URL` above.
# Leave empty to use the default Copernicus / NASA GIBS attribution string.
VITE_SATELLITE_ATTRIBUTION=
